# ---- Database ----
# Async driver for the app, sync driver for Alembic.
POSTGRES_USER=sunflower
POSTGRES_PASSWORD=089429756
POSTGRES_DB=sunflower
DATABASE_URL=postgresql+asyncpg://sunflower:089429756@db:5432/sunflower
ALEMBIC_DATABASE_URL=postgresql+psycopg://sunflower:089429756@db:5432/sunflower

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALG=HS256
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# ---- API ----
ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# ---- Media storage ----
# local | s3
MEDIA_BACKEND=local
MEDIA_ROOT=/var/lib/sunflower/media
MEDIA_PUBLIC_URL=http://localhost:8000/media
MEDIA_MAX_BYTES=5242880

# ---- Seed admin (scripts/seed.py) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# ---- Frontend (Vite needs the VITE_ prefix) ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
