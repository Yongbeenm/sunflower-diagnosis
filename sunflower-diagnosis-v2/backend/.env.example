# Database Configuration
# For local development (SQLite)
DATABASE_URL=sqlite:///./sunflower.db

# For production (PostgreSQL) - Railway/Render will auto-provide this
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Security (REQUIRED - Change this!)
SECRET_KEY=dev-secret-key-change-this-to-random-32-plus-characters
ALGORITHM=HS256

# JWT Token Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (comma-separated)
# Add your frontend domains here
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app

# Application Settings (Optional)
PROJECT_NAME=Doctor Sunflower
VERSION=2.0.0
API_V1_PREFIX=/api/v1

# File Upload (Optional)
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_EXTENSIONS=png,jpg,jpeg,webp
UPLOAD_DIR=./uploads
